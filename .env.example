# PostgreSQL Database Configuration
POSTGRES_USER=infisical
POSTGRES_PASSWORD=your-secure-postgres-password
POSTGRES_DB=infisical

# Infisical Encryption Keys
# Generate these using: openssl rand -hex 16
ENCRYPTION_KEY=
JWT_SIGNUP_SECRET=
JWT_REFRESH_SECRET=
JWT_AUTH_SECRET=
JWT_SERVICE_SECRET=
JWT_PROVIDER_AUTH_SECRET=
AUTH_SECRET=

# SMTP Configuration (Optional - for email notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM_ADDRESS=noreply@infisical.slosdev.com
SMTP_FROM_NAME=Infisical

# OAuth Configuration (Optional)
CLIENT_SECRET_GITHUB_LOGIN=
CLIENT_ID_GITHUB_LOGIN=
CLIENT_SECRET_GITLAB_LOGIN=
CLIENT_ID_GITLAB_LOGIN=
CLIENT_SECRET_GOOGLE_LOGIN=
CLIENT_ID_GOOGLE_LOGIN=

# Telemetry
TELEMETRY_ENABLED=false

# HTTPS Configuration
HTTPS_ENABLED=false

# User Management
DISABLE_SIGNUP=false

# Cloudflare Tunnel Token (if using Docker-managed tunnel)
# CLOUDFLARE_TUNNEL_TOKEN=

# AWS S3 Backup Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=your-infisical-backup-bucket
DELETE_OLD_BACKUPS=true
TZ=UTC
